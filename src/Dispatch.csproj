<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Dispatch</AssemblyName>
    <RootNamespace>Dispatch</RootNamespace>
    <ApplicationIcon>Assets\dispatch.ico</ApplicationIcon>
    <Version>0.7.0</Version>
    <Authors>Skye</Authors>
    <Company>Skye</Company>
    <Copyright>Copyright (c) 2026 Skye</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Dispatch</Product>
    <Description>Find a Bodycam server, join it, or send a friend the link.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\dispatch.ico" />
    <InternalsVisibleTo Include="Dispatch.Tests" />
  </ItemGroup>

</Project>
