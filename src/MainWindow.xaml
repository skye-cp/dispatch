<Window x:Class="Dispatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dispatch"
        Title="Dispatch" Width="1180" Height="760" MinWidth="1000" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Dispatch;component/Assets/dispatch.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource RedBrush}" Margin="0,1,9,0" VerticalAlignment="Center" />
                    <TextBlock Text="DISPATCH" FontFamily="{StaticResource HeadFont}" FontSize="17" Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="VersionText" Margin="7,3,0,0" FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                    <Button x:Name="UpdateLink" Style="{StaticResource Link}" FontSize="12" Margin="6,2,0,0" Visibility="Collapsed"
                            Foreground="{StaticResource RedHotBrush}" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnUpdate" />
                    <TextBlock x:Name="Tagline" Margin="16,2,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource RedBrush}" VerticalAlignment="Center"
                               Text="Find a Bodycam server. Join it, or send a friend the link." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="SoundButton" Style="{StaticResource Caption}" Content="&#xE767;" ToolTip="Sounds on. Click to mute."
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnSoundToggle" />
                    <Button x:Name="MinButton" Style="{StaticResource Caption}" Content="&#xE921;" ToolTip="Minimize"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource Caption}" Content="&#xE922;" ToolTip="Maximize"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximize" />
                    <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" ToolTip="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" />
                </StackPanel>
            </Grid>

            <!-- Search, filter toggle, reset, refresh -->
            <Grid Grid.Row="1" Margin="18,6,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource Search}" Tag="Host name  ·  Enter searches every server"
                             TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKey" Padding="0,0,26,0" />
                    <Button x:Name="ClearSearch" Style="{StaticResource Link}" FontFamily="{StaticResource IconFont}" FontSize="10"
                            Content="&#xE711;" HorizontalAlignment="Right" Margin="0,0,3,0" Visibility="Collapsed"
                            ToolTip="Clear (Esc)" Click="OnClearSearch" />
                </Grid>
                <Button x:Name="FilterToggle" Grid.Column="1" Style="{StaticResource Link}" Margin="10,0,0,0" Click="OnToggleFilters">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FilterChevron" FontFamily="{StaticResource IconFont}" FontSize="10" Text="&#xE70E;"
                                   VerticalAlignment="Center" Margin="0,1,7,0" />
                        <TextBlock Text="FILTERS" FontFamily="{StaticResource HeadFont}" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="FilterSummary" Grid.Column="2" Margin="6,0,12,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" FontSize="13" />
                <Button x:Name="ResetButton" Grid.Column="3" Style="{StaticResource Link}" Content="RESET" Margin="0,0,8,0"
                        ToolTip="Clear every filter and the search" Click="OnReset" />
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <ToggleButton x:Name="AutoToggle" Style="{StaticResource Chip}" Margin="0,0,8,0" Padding="10,5,10,6" Content="AUTO"
                                  ToolTip="Refresh every minute while Dispatch is open, and mark servers that appear. Each refresh shows you as playing Bodycam on Steam for a second."
                                  Checked="OnAutoChanged" Unchecked="OnAutoChanged" />
                    <Button x:Name="RefreshButton" Style="{StaticResource Square}" Content="&#xE72C;"
                            ToolTip="Refresh from Steam (F5)" Click="OnRefresh" />
                </StackPanel>
            </Grid>

            <!-- Filters -->
            <Border x:Name="FilterPanel" Grid.Row="2" Margin="18,0,18,10" Padding="14,12,8,6"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="MODE" />
                    <WrapPanel x:Name="ModeChips" Grid.Column="1" />
                    <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="MAP" />
                    <WrapPanel x:Name="MapChips" Grid.Row="1" Grid.Column="1" />
                    <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="REGION" />
                    <WrapPanel x:Name="RegionChips" Grid.Row="2" Grid.Column="1" />
                    <TextBlock Style="{StaticResource Label}" Grid.Row="3" Text="PING" />
                    <Grid Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel x:Name="PingChips" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="BOTS" Margin="28,5,12,0" />
                        <WrapPanel x:Name="BotChips" Grid.Column="2" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Label}" Text="AGE" Margin="28,5,12,0" />
                        <WrapPanel x:Name="AgeChips" Grid.Column="4" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Column header: the game's red bar -->
            <Grid Grid.Row="3" Margin="18,0,18,6">
                <Border Background="{StaticResource RedBrush}" CornerRadius="2" Height="34">
                    <!-- 1 px each side matches the row border; the list's scroll bar sits in the gutter to the right. -->
                    <Grid x:Name="HeaderGrid" Margin="1,0,1,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="146" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="84" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="HeadName" Style="{StaticResource HeaderCell}" Tag="Name" Click="OnSort" />
                        <Button x:Name="HeadSlots" Grid.Column="1" Style="{StaticResource HeaderCell}" Tag="Slots" Click="OnSort"
                                ToolTip="Server size. Steam does not publish how many players are in." />
                        <Button x:Name="HeadMode" Grid.Column="2" Style="{StaticResource HeaderCell}" Tag="Mode" Click="OnSort" />
                        <Button x:Name="HeadMap" Grid.Column="3" Style="{StaticResource HeaderCell}" Tag="Map" Click="OnSort" />
                        <Button x:Name="HeadBots" Grid.Column="4" Style="{StaticResource HeaderCell}" Tag="Bots" Click="OnSort" />
                        <Button x:Name="HeadRegion" Grid.Column="5" Style="{StaticResource HeaderCell}" Tag="Region" Click="OnSort" />
                        <Button x:Name="HeadAge" Grid.Column="6" Style="{StaticResource HeaderCell}" Tag="Age" Click="OnSort"
                                ToolTip="How long ago the server was created, estimated from Steam's lobby numbering." />
                        <Button x:Name="HeadPing" Grid.Column="7" Style="{StaticResource HeaderCell}" Tag="Ping" Click="OnSort"
                                ToolTip="Steam's estimate of your round trip to the host, in milliseconds, through its relay network." />
                    </Grid>
                </Border>
                <Canvas x:Name="ProgressTrack" Height="2" VerticalAlignment="Bottom" ClipToBounds="True" Margin="0,0,0,-4" Visibility="Hidden">
                    <Rectangle x:Name="ProgressBar" Width="160" Height="2" Fill="{StaticResource RedHotBrush}" />
                </Canvas>
            </Grid>

            <!-- Server list -->
            <Grid Grid.Row="4" Margin="18,2,8,0">
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Row}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.ScrollUnit="Pixel"
                         Padding="0,0,0,0" MouseDoubleClick="OnListDoubleClick" PreviewKeyDown="OnListKey"
                         SelectionChanged="OnSelectionChanged" ContextMenuOpening="OnRowMenuOpening"
                         PreviewMouseWheel="OnListWheel" ManipulationBoundaryFeedback="OnBoundaryFeedback">
                    <ListBox.RenderTransform>
                        <TranslateTransform x:Name="PullShift" />
                    </ListBox.RenderTransform>
                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="RowMenu">
                            <MenuItem Header="Join server" InputGestureText="Enter" Click="OnJoin" />
                            <MenuItem Header="Copy invite link" InputGestureText="Ctrl+C" Click="OnCopyLink" />
                            <MenuItem Header="Copy host name" Click="OnCopyName" />
                            <MenuItem Header="Search this host" Click="OnSearchHost" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="146" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="84" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="NewMark" Width="3" HorizontalAlignment="Left" Margin="-1,-1,0,-1"
                                           Fill="{StaticResource RedBrush}" Visibility="Collapsed" ToolTip="New since the list first loaded" />
                                <Grid Margin="8,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Star" RenderTransformOrigin="0.5,0.5" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="13" Width="16"
                                               VerticalAlignment="Center" Margin="0,1,6,0" Foreground="{StaticResource TextFaintBrush}"
                                               Background="Transparent" Cursor="Hand" Opacity="0" Tag="star"
                                               MouseLeftButtonUp="OnStarClick" ToolTip="Follow this host: pin their server and alert me when it appears">
                                        <TextBlock.RenderTransform><ScaleTransform /></TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource HeadFont}" FontSize="15"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                    <Border x:Name="FriendBadge" RenderTransformOrigin="0,0.5" Grid.Column="2" Margin="10,1,0,0" Padding="5,0,5,1" CornerRadius="2"
                                            BorderBrush="{StaticResource RedBrush}" BorderThickness="1" VerticalAlignment="Center"
                                            Visibility="Collapsed" ToolTip="{Binding FriendTip}">
                                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        <TextBlock Text="FRIEND" FontFamily="{StaticResource HeadFont}" FontSize="10" Foreground="{StaticResource RedHotBrush}" />
                                    </Border>
                                    <Border x:Name="RoundBadge" RenderTransformOrigin="0,0.5" Grid.Column="3" Margin="8,1,0,0" Padding="5,0,5,1" CornerRadius="2"
                                            BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" VerticalAlignment="Center"
                                            Visibility="Collapsed" ToolTip="The map or mode just changed: a new round has started. Best moment to join.">
                                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        <TextBlock Text="NEW ROUND" FontFamily="{StaticResource HeadFont}" FontSize="10" Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                    <Ellipse x:Name="Dot" Grid.Column="4" Width="9" Height="9" Fill="White" Margin="10,1,0,0"
                                             HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Hidden" />
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding SlotsText, NotifyOnTargetUpdated=True}" local:Motion.AnimateChanges="True" Margin="12,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDimBrush}" FontSize="15" />
                                <!-- Values tagged with a filter kind toggle that filter when clicked. -->
                                <TextBlock Grid.Column="2" Text="{Binding Mode, NotifyOnTargetUpdated=True}" local:Motion.AnimateChanges="True" Margin="12,0" VerticalAlignment="Center" FontSize="15"
                                           HorizontalAlignment="Left" Style="{StaticResource CellLink}" Tag="mode"
                                           MouseLeftButtonUp="OnCellClick" ToolTip="" ToolTipOpening="OnCellTip" />
                                <TextBlock Grid.Column="3" Text="{Binding MapName, NotifyOnTargetUpdated=True}" local:Motion.AnimateChanges="True" Margin="12,0" VerticalAlignment="Center" FontSize="15"
                                           HorizontalAlignment="Left" Style="{StaticResource CellLink}" Tag="map"
                                           MouseLeftButtonUp="OnCellClick" ToolTip="" ToolTipOpening="OnCellTip" />
                                <TextBlock Grid.Column="4" Text="{Binding BotsText, NotifyOnTargetUpdated=True}" local:Motion.AnimateChanges="True" Margin="12,0" VerticalAlignment="Center" FontSize="15"
                                           HorizontalAlignment="Left" Style="{StaticResource CellLink}" Tag="bots"
                                           MouseLeftButtonUp="OnCellClick" ToolTip="" ToolTipOpening="OnCellTip" />
                                <TextBlock Grid.Column="5" Text="{Binding RegionName}" Margin="12,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDimBrush}" FontSize="14" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Left" Style="{StaticResource CellLink}" Tag="region"
                                           MouseLeftButtonUp="OnCellClick" ToolTip="" ToolTipOpening="OnCellTip" />
                                <TextBlock Grid.Column="6" Text="{Binding AgeText, NotifyOnTargetUpdated=True}" local:Motion.AnimateChanges="True" Margin="12,0" VerticalAlignment="Center" FontSize="15"
                                           Foreground="{StaticResource TextDimBrush}"
                                           HorizontalAlignment="Left" Style="{StaticResource CellLink}" Tag="age"
                                           MouseLeftButtonUp="OnCellClick" ToolTip="" ToolTipOpening="OnCellTip" />
                                <StackPanel Grid.Column="7" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                    <Rectangle x:Name="PingBar" Width="3" Height="12" Margin="0,1,8,0" Fill="{StaticResource LineStrongBrush}" />
                                    <TextBlock x:Name="PingText" Text="{Binding PingText, NotifyOnTargetUpdated=True}" local:Motion.AnimateChanges="True" FontSize="15" Foreground="{StaticResource TextFaintBrush}"
                                               Style="{StaticResource CellLink}" Tag="ping"
                                               MouseLeftButtonUp="OnCellClick" ToolTip="" ToolTipOpening="OnCellTip" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Star" Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Star" Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFollowed}" Value="True">
                                    <Setter TargetName="Star" Property="Text" Value="&#xE735;" />
                                    <Setter TargetName="Star" Property="Foreground" Value="{StaticResource RedHotBrush}" />
                                    <Setter TargetName="Star" Property="Opacity" Value="1" />
                                    <Setter TargetName="Star" Property="ToolTip" Value="Following this host. Click to stop." />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Star" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetName="Star" Storyboard.TargetProperty="RenderTransform.ScaleX" From="1.6" To="1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="Star" Storyboard.TargetProperty="RenderTransform.ScaleY" From="1.6" To="1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding IsFriend}" Value="True">
                                    <Setter TargetName="FriendBadge" Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="FriendBadge" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetName="FriendBadge" Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.6" To="1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="FriendBadge" Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.6" To="1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding IsNewRound}" Value="True">
                                    <Setter TargetName="RoundBadge" Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RoundBadge" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetName="RoundBadge" Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.6" To="1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="RoundBadge" Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.6" To="1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                    <Setter TargetName="NewMark" Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="NewMark" Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:1:30" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PingLevel}" Value="Good">
                                    <Setter TargetName="PingText" Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter TargetName="PingBar" Property="Fill" Value="{StaticResource GoodBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PingLevel}" Value="Fair">
                                    <Setter TargetName="PingText" Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter TargetName="PingBar" Property="Fill" Value="{StaticResource FairBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PingLevel}" Value="Poor">
                                    <Setter TargetName="PingText" Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                    <Setter TargetName="PingBar" Property="Fill" Value="{StaticResource RedBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="PullTop" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,10,10,0" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="-1">
                    <TextBlock x:Name="PullTopIcon" FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE72C;" VerticalAlignment="Center"
                               Foreground="{StaticResource RedHotBrush}" Margin="0,1,8,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform><RotateTransform /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="PullTopText" FontFamily="{StaticResource HeadFont}" FontSize="13" Foreground="{StaticResource TextDimBrush}"
                               Text="PULL TO REFRESH" />
                </StackPanel>
                <StackPanel x:Name="PullBottom" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,10,10" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="-1">
                    <TextBlock x:Name="PullBottomIcon" FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE72C;" VerticalAlignment="Center"
                               Foreground="{StaticResource RedHotBrush}" Margin="0,1,8,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform><RotateTransform /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="PullBottomText" FontFamily="{StaticResource HeadFont}" FontSize="13" Foreground="{StaticResource TextDimBrush}"
                               Text="PULL TO REFRESH" />
                </StackPanel>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" Foreground="{StaticResource TextDimBrush}" FontSize="15"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                    <Button x:Name="EmptyAction" Style="{StaticResource Ghost}" HorizontalAlignment="Center" Margin="0,14,0,0"
                            Visibility="Collapsed" Click="OnEmptyAction" />
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="5" Margin="18,10,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Status" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RecentButton" Style="{StaticResource Ghost}" Margin="0,0,8,0"
                            ToolTip="Rejoin a server you joined recently" Click="OnRecent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE81C;" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="RECENT" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="RecentMenu" Placement="Top" />
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="ClipboardButton" Style="{StaticResource Ghost}" Margin="0,0,8,0" Visibility="Collapsed"
                            ToolTip="A Bodycam invite link is on your clipboard (Ctrl+Shift+V)" Click="OnJoinClipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE77F;" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="JOIN PASTED LINK" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CopyButton" Style="{StaticResource Ghost}" Margin="0,0,8,0" ToolTip="Copy an invite link for a friend (Ctrl+C)"
                            Click="OnCopyLink">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE71B;" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="COPY INVITE LINK" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="JoinButton" Style="{StaticResource Primary}" MinWidth="110" ToolTip="Join this server (Enter or double-click)"
                            Click="OnJoin" Content="JOIN" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
